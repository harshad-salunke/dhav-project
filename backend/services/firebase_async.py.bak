"""
Async wrappers around the (synchronous) Firebase Admin SDK.

WHY THIS EXISTS
---------------
`db.reference(path).get()` is a *blocking* network call. FastAPI runs every
`async def` handler on a single event-loop thread, so calling the blocking SDK
directly inside an async route freezes the ENTIRE server until Firebase
responds — every other request and every WebSocket location broadcast stalls
with it.

The fix is to push each blocking call onto a thread pool and `await` it. The
event loop stays free to serve other requests while the thread waits on the
network. This is the single most important change for scaling to many
concurrent users.

USAGE
-----
    from services import firebase_async as fb
    order = await fb.get(f"orders/{order_id}")
    await fb.update(f"orders/{order_id}", {"status": "accepted"})
    a, b = await fb.get_many(["stores/s1", "stores/s2"])   # concurrent
"""
import asyncio
from concurrent.futures import ThreadPoolExecutor
from typing import Any, Callable

from firebase_admin import db

# One shared pool for ALL blocking Firebase calls across the app. Bounds how
# many Firebase requests run at once (back-pressure) while keeping the event
# loop free. 32 is comfortable for RTDB; raise if you add more workers.
_executor = ThreadPoolExecutor(max_workers=32, thread_name_prefix="fb")


async def _run(fn: Callable[[], Any]) -> Any:
    loop = asyncio.get_event_loop()
    return await loop.run_in_executor(_executor, fn)


async def get(path: str) -> Any:
    return await _run(lambda: db.reference(path).get())


async def get_many(paths: list[str]) -> list[Any]:
    """Read several paths concurrently. Replaces N+1 sequential loops."""
    return await asyncio.gather(*[get(p) for p in paths])


async def set(path: str, value: Any) -> None:
    await _run(lambda: db.reference(path).set(value))


async def update(path: str, value: dict) -> None:
    await _run(lambda: db.reference(path).update(value))


async def delete(path: str) -> None:
    await _run(lambda: db.reference(path).delete())


async def query_equal(path: str, child: str, value: Any) -> Any:
    """`order_by_child(child).equal_to(value)` — run off the event loop."""
    return await _run(
        lambda: db.reference(path).order_by_child(child).equal_to(value).get()
    )


async def transaction(path: str, txn_fn: Callable[[Any], Any]) -> Any:
    return await _run(lambda: db.reference(path).transaction(txn_fn))


async def run(fn: Callable[[], Any]) -> Any:
    """Escape hatch: run any blocking callable on the Firebase pool."""
    return await _run(fn)
